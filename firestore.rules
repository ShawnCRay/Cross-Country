rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the link can read (parents, runners). Only listed coach emails can write.
    // Keep this list in sync with editorEmails in src/firebase-config.ts.
    match /teams/{team}/{collection}/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['coach@example.com'];
    }
  }
}
